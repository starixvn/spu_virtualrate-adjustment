<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6" />
  </startup>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider,Fanex.Data" resourcePath="App_Data" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <connectionStrings>
    <add name="DBDW.bodb_dwrs.bodbAdminNet"
         connectionString="Data Source=10.40.40.100;Asynchronous Processing=true;Initial Catalog=bodb_dwrs;integrated security=false; user id=bodbAdminNet; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr="
         providerName="System.Data.SqlClient" />
    <add name="DBFD.FraudDetection.bodbSPUNet"
         connectionString="Data Source=10.40.40.95;Asynchronous Processing=true;Initial Catalog=SPU_FraudDetection;User Id=bodbSPUNet;Password=l4exNQ2KUgCjzhehUWfktg==="
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="learning rate" value="7" />
    <add key="error threshold" value="0.011" />
    <add key="windowed threshold" value="0.3" />
  </appSettings>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" />
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="FSharp.Core" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.4.0.0" newVersion="4.4.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>